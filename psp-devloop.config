# psp-devloop profile for this project.
#
#   https://github.com/chriopter/psp-devloop
#
# Run with:  /path/to/psp-devloop/devloop psp-devloop.config
#
# Exit codes: 0 pass, 77 skipped on purpose, anything else a failure that stops
# the loop. Success comes from the result file the demo writes, never from
# emulator output. A green emulator stage is not proof that this runs on a PSP;
# only stage 03 answers that, and there is no PSP here.

PSP_PROJECT_DIR="$PSP_DEVLOOP_CONFIG_DIR"


# STAGES

# 01 — build. rustup was installed without touching PATH, so name it here.
DEBUG_COMMAND='PATH="$HOME/.cargo/bin:$PATH" RUSTUP_TOOLCHAIN=nightly cargo psp --release'

PPSSPP_TEST_COMMAND='"$PSP_DEVLOOP_ROOT/lib/run-project" ppsspp'

# JPCSP would be a useful second opinion — it models the hardware differently —
# but this demo writes its result through sceIoOpen on ms0:, and that path has
# not been checked there yet.
JPCSP_TEST_COMMAND=''

HARDWARE_TEST_COMMAND=''
HARDWARE_RECOVERY_COMMAND=''


# EMULATOR SETTINGS

# PPSSPP's memory stick lives under state/ppsspp, so ms0:/ maps to there.
result_file="$PSP_PROJECT_DIR/state/ppsspp/raytracer-result.json"

ppsspp_command='./run-in-ppsspp.sh'

# 600 frames at roughly 17 fps is about 35 seconds of emulated time, and the
# emulator is slower than that. Three minutes leaves room without letting a
# hung run block the loop indefinitely.
ppsspp_timeout=180


# HOOKS

# A result file from an earlier run must never be mistaken for this one.
# psp-devloop removes it too; doing it here as well keeps a manual run honest.
stage() {
  rm -f "$result_file"
  mkdir -p "$PSP_PROJECT_DIR/state/ppsspp/PSP"
}

# The demo renders a fixed number of frames, so a short run means it died part
# way through. Checking the count catches that; checking the JSON parses
# catches a truncated write.
check() {
  python3 - "$result_file" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
if data.get("frames") != 600:
    raise SystemExit(f"expected 600 frames, got {data.get('frames')}")
if data.get("fps", 0) <= 0:
    raise SystemExit("frame rate is not positive")
print(f"  {data['frames']} frames, {data['fps']} fps, {data['frame_ms']} ms per frame")
PY
}
